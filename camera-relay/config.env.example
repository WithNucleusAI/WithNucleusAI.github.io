# Shared settings for the sender + receiver scripts.
# Copy to config.env and fill in. The sender and receiver both `source` it.
#   cp config.env.example config.env && edit config.env
#
# config.env is gitignored so your relay IP + passwords never get committed.

# Public IP (or hostname) of your relay VPS.
RELAY_IP="203.0.113.10"

# SRT port from mediamtx.yml (srtAddress).
RELAY_PORT="8890"

# Must match the passwords you put in relay/mediamtx.yml.
PUBLISH_PASSWORD="CHANGE_ME_PUBLISH_PASSWORD"
VIEW_PASSWORD="CHANGE_ME_VIEW_PASSWORD"

# Optional AES encryption of the SRT link (recommended on the open internet).
# Leave blank to disable. If set, it must be identical on sender AND receiver.
#   SRT_PASSPHRASE="a-long-shared-secret-16plus-chars"
SRT_PASSPHRASE=""

# --- Sender capture (California) -------------------------------------------
# Linux webcam device / macOS avfoundation index. See sender/send-webcam.sh.
VIDEO_SIZE="1280x720"
FRAMERATE="30"
VIDEO_BITRATE="2500k"   # bump to 4000k for 1080p, drop to 1200k on a weak link
